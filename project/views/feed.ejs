<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/feed.css">
    <title>Infinite Feed</title>
</head>

<body>
    <main class="feed">
        <h1>Latest Posts</h1>

        <section id="feed" aria-live="polite">
            <% (posts || []).forEach(post => { %>
                <article class="post">
                    <div class="post-header">
                        <h2 class="post_title"><%= post.title ?? "Untitled" %></h2>
                    </div>

                    <div class="meta">
                        <span class="post_published_date"><%= post.published_date ?? "Date unknown" %></span>
                        <% if (post.location) { %>
                            · <span class="post_location"><%= post.location %></span>
                        <% } %>
                        <% if (post.category) { %>
                            · <span class="post_category"><%= post.category %></span>
                        <% } %>
                    </div>

                    <% if (post.price != null) { %>
                        <div class="price">
                            <%= post.price %>
                        </div>
                    <% } %>

                    <div class="description">
                        <%= post.description ?? "" %>
                    </div>

                    <% if (post.read_more?.summary) { %>
                        <div class="read-more">
                            <strong>Read more</strong>
                            <p class="post_read_more"><%= post.read_more.summary %></p>

                            <% if (post.read_more.source_url) { %>
                                <a href="<%= post.read_more.source_url %>"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    View source
                                </a>
                            <% } %>
                        </div>
                    <% } %>

                    <div class="interaction">
                        <span class="likes">♥ <%= post.interaction?.likes ?? 0 %> likes</span>
                        <span class="comments">💬 <%= post.interaction?.comments_count ?? 0 %> comments</span>
                    </div>
                </article>
            <% }) %>
        </section>

        <div id="feed-status" role="status">
            Loading more posts...
        </div>

        <div id="feed-sentinel" aria-hidden="true"></div>
    </main>

    <script>
        let offset = <%= (posts || []).length %>;
    </script>

    <script src="/JavaScript/feed.js" defer></script>
</body>
</html>
